<UserControl x:Class="SvgXamlTest.ToggleSvgButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SvgXamlTest"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <ToggleButton x:Name="Toggle" IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}">
        <svgc:SvgViewbox x:Name="SvgIcon" 
                         AppName="{Binding AppName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Source="{Binding SvgSource, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </ToggleButton>

</UserControl>
