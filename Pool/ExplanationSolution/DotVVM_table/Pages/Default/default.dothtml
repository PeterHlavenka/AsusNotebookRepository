@viewModel DotVVM_table.Pages.Default.DefaultViewModel, DotVVM_table

<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <title></title>
</head>
<body>
    <h1>{{value: Title}}</h1>
     
     <dot:Repeater DataSource="{value: ItemsList}">
       <ItemTemplate>
         {{value: _this}}<br />
       </ItemTemplate>
     </dot:Repeater>
     
     <dot:Repeater DataSource="{value: Messages}">
            <ItemTemplate>
              {{value: _this}}<br />
            </ItemTemplate>
     </dot:Repeater>
     
 
     
     
<dot:GridView DataSource="{value: RabbitMessages}" border="0">
    <Columns>
     <dot:GridViewTextColumn HeaderText="Country" ValueBinding="{value: Country}" />
     <dot:GridViewTextColumn HeaderText="Environment" ValueBinding="{value: Environment}" />
     <dot:GridViewTextColumn HeaderText="Service name" ValueBinding="{value: ServiceName}" />
     <dot:GridViewTextColumn HeaderText="Import date" ValueBinding="{value: ImportDate}" />
     <dot:GridViewTextColumn HeaderText="Data type" ValueBinding="{value: DataType}" />
    </Columns>
</dot:GridView>
</body>
</html>