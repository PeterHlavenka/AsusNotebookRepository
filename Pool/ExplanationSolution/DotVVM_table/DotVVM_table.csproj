<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!--Include DotVVM Views, MasterPages and Controls -->
        <Content Include="**/*.dothtml;**/*.dotmaster;**/*.dotlayout;**/*.dotcontrol" Exclude="obj/**/*.*;bin/**/*.*" CopyToPublishDirectory="PreserveNewest"/>

        <None Remove="dotvvm_serialized_config.json.tmp"/>

        <Folder Include="wwwroot\"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="DotVVM.AspNetCore" Version="4.2.*"/>
        <PackageReference Include="DotVVM.Controls.Bootstrap" Version="4.3.0" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.3" />
        <PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\RabbitCommon\RabbitCommon.csproj" />
      <ProjectReference Include="..\Threading\Threading.csproj" />
      <ProjectReference Include="C:\Pool\Adwind_Kite\Adwind\Apps\Adwind.RabbitCommon\Adwind.RabbitCommon.csproj" />
      <ProjectReference Include="C:\Pool\Adwind_Kite\Adwind\Apps\Adwind.RabbitCommon\RabbitCommon.csproj" />
    </ItemGroup>
    <ItemGroup>
      <Reference Include="RabbitCommon">
        <HintPath>bin\Debug\net7.0\RabbitCommon.dll</HintPath>
      </Reference>
    </ItemGroup>
    <Target Name="CreateWWWRoot" AfterTargets="AfterPublish">
        <MakeDir Directories="$(PublishDir)wwwroot" Condition="!Exists('$(PublishDir)wwwroot')"/>
    </Target>
</Project>
