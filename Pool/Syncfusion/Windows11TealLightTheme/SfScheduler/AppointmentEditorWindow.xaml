<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themelocal="clr-namespace:Syncfusion.Themes.Windows11TealLightTheme.WPF"
                    xmlns:listCollection="clr-namespace:System.Collections;assembly=mscorlib"
                    xmlns:sfskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
                    xmlns:input="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf"
                    xmlns:scheduler="clr-namespace:Syncfusion.UI.Xaml.Scheduler;assembly=Syncfusion.SfScheduler.WPF"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:syncfusion="http://schemas.syncfusion.com/wpf">

    <ResourceDictionary.MergedDictionaries>       
        <sfskin:ResourceDictionaryProvider DictionaryName="Common" ThemeName="Windows11TealLightTheme"/>
        <sfskin:ResourceDictionaryProvider DictionaryName="Brushes" ThemeName="Windows11TealLightTheme"/>
        <ResourceDictionary Source="/Syncfusion.SfScheduler.WPF;component/Reminder/SchedulerReminderControl.xaml" />
        <ResourceDictionary Source="/Syncfusion.Themes.Windows11TealLightTheme.WPF;component/MSControl/Button.xaml" />
        <ResourceDictionary Source="/Syncfusion.Themes.Windows11TealLightTheme.WPF;component/MSControl/FlatButton.xaml" />
        <ResourceDictionary Source="/Syncfusion.Themes.Windows11TealLightTheme.WPF;component/MSControl/GlyphButton.xaml" />
        <ResourceDictionary Source="/Syncfusion.Themes.Windows11TealLightTheme.WPF;component/MSControl/PrimaryButton.xaml" />
        <ResourceDictionary Source="/Syncfusion.Themes.Windows11TealLightTheme.WPF;component/MSControl/FlatPrimaryButton.xaml" />
        <ResourceDictionary Source="/Syncfusion.Themes.Windows11TealLightTheme.WPF;component/ColorPicker/ColorPicker.xaml" />
        <ResourceDictionary Source="/Syncfusion.Themes.Windows11TealLightTheme.WPF;component/ChromelessWindow/ChromelessWindow.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <scheduler:InverseBooleanToVisibilityConverter x:Key="inverseBooleanToVisibilityConverter"/>
    <scheduler:ReminderTimeIntervalConverter x:Key="ReminderTimeIntervalConverter"/>

    <DataTemplate x:Key="SyncfusionSchedulerComboBoxItemTemplate">
        <TextBlock Height="24" Padding="2,4,4,4" VerticalAlignment="Center" Text="{Binding}"/>
    </DataTemplate>

    <Style x:Key="SyncfusionSchedulerReminderListViewItemStyle" TargetType="ListViewItem">
     <Setter Property="Height" Value="35"/>
     <Setter Property="Width" Value="480"/>
     <Setter Property="Template">
         <Setter.Value>
             <ControlTemplate TargetType="ListViewItem">
                 <Border x:Name="border" Background="Transparent">
                     <VisualStateManager.VisualStateGroups>
                         <VisualStateGroup x:Name="SelectionStates">
                             <VisualState x:Name="Selected">
                                 <Storyboard>
                                     <ColorAnimationUsingKeyFrames Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                                         <EasingColorKeyFrame KeyTime="0" Value="Transparent" />
                                     </ColorAnimationUsingKeyFrames>
                                 </Storyboard>
                             </VisualState>
                         </VisualStateGroup>
                     </VisualStateManager.VisualStateGroups>
                     <ContentPresenter/>
                 </Border>
             </ControlTemplate>
         </Setter.Value>
     </Setter>
    </Style>

    <Style x:Key="SyncfusionAppointmentEditorColorPickerForegroundStyle" TargetType="{x:Type input:ColorPicker}"
           BasedOn="{StaticResource SyncfusionColorPickerStyle}">
        <Setter Property="Brush" Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=PrimaryForeground}}" />
    </Style>

    <Style x:Key="SyncfusionAppointmentEditorColorPickerBackgroundStyle" TargetType="{x:Type input:ColorPicker}" 
           BasedOn="{StaticResource SyncfusionColorPickerStyle}">
        <Setter Property="Brush" Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=PrimaryBackground}}" />
    </Style>

    <Style x:Key="SyncfusionAppointmentEditorFlatButtonStyle"
            BasedOn="{StaticResource WPFButtonStyle}"
            TargetType="{x:Type Button}" >
    </Style>

    <Style x:Key="SyncfusionAppointmentEditorPrimaryButtonStyle"
            BasedOn="{StaticResource WPFPrimaryButtonStyle}"
            TargetType="{x:Type Button}" >
    </Style>

    <Style x:Key="SyncfusionRecurrenceEditorPrimaryButtonStyle"
            BasedOn="{StaticResource WPFPrimaryButtonStyle}"
            TargetType="{x:Type Button}" >
    </Style>

    <Style x:Key="SyncfusionEditorFlatButtonStyle"
            BasedOn="{StaticResource WPFButtonStyle}"
            TargetType="{x:Type Button}" >
    </Style>

    <Style x:Key="SyncfusionAppointmentEditorGlyphButtonStyle"
            BasedOn="{StaticResource WPFGlyphButtonStyle}"
            TargetType="{x:Type Button}" >
    </Style>

    <Style x:Key="SyncfusionReminderCloseButtonStyle" TargetType="{x:Type Path}">
        <Setter Property="Data">
            <Setter.Value>
                <PathGeometry>M11 1L1 11M1 1L11 11</PathGeometry>
            </Setter.Value>
        </Setter>
        <Setter Property="Stroke" Value="{StaticResource IconColor}"/>
    </Style>

    <DataTemplate x:Key="SyncfusionSchedulerColorPickerHeaderTemplate">
        <StackPanel Orientation="Horizontal">
            <Border BorderBrush="LightGray" 
                    BorderThickness="1"
                    x:Name="selectedColorRect"
                    Width="13"
                    Height="13" 
                    CornerRadius="{StaticResource Windows11TealLightTheme.CornerRadius2}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{Binding Brush, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type input:ColorPicker}}}" />
        </StackPanel>
    </DataTemplate>

    <Style TargetType="scheduler:RecurrenceEditorControl" x:Key="SyncfusionRecurrenceEditorControlStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="scheduler:RecurrenceEditorControl">
                    <StackPanel x:Name="EditEvent" Margin="24,0,24,0" Orientation="Vertical">
                        <TextBlock x:Name="PART_RecurrenceTextBlock" 
                                   Width="300"  Margin="0,8,0,8"
                                   Height="Auto" 
                                   HorizontalAlignment="Left" 
                                   VerticalAlignment="Center"
                                   Text="This is one appointment in a series. What do you want to open?"
                                   TextWrapping="WrapWithOverflow" 
                                   FontSize="14"/>

                        <RadioButton x:Name="PART_SingleRadioButton" Width="Auto" 
                                     Height="32"
                                     Content="Just this one"
                                     GroupName="Recurrence"
                                     Margin="0,8,0,0"
                                     IsChecked="True" 
                                     FontSize="14"/>

                        <RadioButton x:Name="PART_SeriesRadioButton"
                                     Height="32"
                                     Width="Auto" 
                                     Margin="0,4,0,8"
                                     Content="The entire series"
                                     GroupName="Recurrence" 
                                     FontSize="14"/>

                        <StackPanel Orientation="Horizontal" Height="32" HorizontalAlignment="Right" Margin="0,8,0,24">
                            <Button x:Name="PART_RecurrenceOkButton" 
                                    Style="{StaticResource SyncfusionRecurrenceEditorPrimaryButtonStyle}"
                                    Width="70" Height="24" 
                                    IsDefault="True"/>
                            <Button x:Name="PART_RecurrenceCancelButton" 
                                    Margin="12,0,0,0" 
                                    Style="{StaticResource SyncfusionEditorFlatButtonStyle}"
                                    Width="70" Height="24"  
                                    IsCancel="True" />
                        </StackPanel>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource SyncfusionRecurrenceEditorControlStyle}" TargetType="scheduler:RecurrenceEditorControl"/>
    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Control=Syncfusion.UI.Xaml.Scheduler.RecurrenceEditorControl}" BasedOn="{StaticResource SyncfusionRecurrenceEditorControlStyle}" TargetType="scheduler:RecurrenceEditorControl"/>

    <Style TargetType="scheduler:AppointmentEditorControl" x:Key="SyncfusionAppointmentEditorControlStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="scheduler:AppointmentEditorControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="ScrollViewer" Height="Auto" Background="Transparent" HorizontalScrollBarVisibility="Hidden" IsDeferredScrollingEnabled="False" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="EditorView" Orientation="Vertical">

                                <Grid x:Name="BasicEditorGrid" Height="Auto">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Label x:Name="TitleLabel" Margin="8,0,0,0" />
                                    <Label x:Name="LocationLabel" Grid.Column="1" Margin="3,0,0,0" />
                                    
                                    <TextBox x:Name="SubjectTextBox" 
                                             Grid.Row="1" 
                                             Grid.Column="0" 
                                             Margin="14,0,0,0"
                                             Height="24"
                                             HorizontalAlignment="Left" 
                                             VerticalAlignment="Top"
                                             Width="238" 
                                             AutomationProperties.Name="Title"/>

                                    <TextBox x:Name="LocationTextBox" 
                                             Grid.Row="1" 
                                             Grid.Column="1" 
                                             Margin="9,0,0,0"
                                             Height="24"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Width="238" 
                                             AutomationProperties.Name="Location"/>

                                    <Label x:Name="StartLabel"
                                           Grid.Row="2" 
                                           Grid.Column="0" 
                                           Margin="8,8,0,0" />

                                    <Label x:Name="EndLabel"
                                           Grid.Row="2" 
                                           Grid.Column="1"
                                           Margin="3,8,0,0" />

                                    <Grid Grid.Row="3" 
                                          Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <syncfusion:SfDatePicker x:Name="StartDatePicker"
                                                                 HorizontalAlignment="Left"
                                                                 Width="112" 
                                                                 Margin="14,0,0,0"
                                                                 VerticalAlignment="Top"/>
                                        <syncfusion:SfTimePicker x:Name="StartTimePicker"
                                                                 Grid.Column="1"
                                                                 Margin="11,0,0,0"
                                                                 Width="112"
                                                                 HorizontalAlignment="Left" 
                                                                 VerticalAlignment="Top"
                                                                  Visibility="{Binding IsChecked,ElementName=AllDayCheckBox,Mode=TwoWay,Converter={StaticResource inverseBooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <Grid  Grid.Row="3" 
                                           Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <syncfusion:SfDatePicker x:Name="EndDatePicker" 
                                                                 Margin="9,0,0,0" 
                                                                 VerticalAlignment="Top" 
                                                                 HorizontalAlignment="Left" Width="112"/>
                                        <syncfusion:SfTimePicker x:Name="EndTimePicker"
                                                                 Grid.Column="1" Margin="5,0,0,0"
                                                                 Width="112"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Top"
                                                                 Visibility="{Binding IsChecked,ElementName=AllDayCheckBox,Mode=TwoWay,Converter={StaticResource inverseBooleanToVisibilityConverter}}"/>
                                    </Grid>
                                    <Grid x:Name="AllDayTimeZoneGrid"
                                          Grid.Row="4"
                                          Margin="0,10,0,0"
                                          Height="Auto">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox x:Name="AllDayCheckBox" 
                                                  Margin="14,0,0,0" 
                                                  Width="110"
                                                  HorizontalAlignment="Left"/>

                                        <CheckBox x:Name="TimeZoneCheckBox" 
                                                  Grid.Column="1" 
                                                  HorizontalAlignment="Left"  
                                                  Width="110" Margin="10,0,0,0"
                                                  Visibility="{Binding IsChecked,ElementName=AllDayCheckBox,Mode=OneWay,Converter={StaticResource inverseBooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <Grid x:Name="ColorPickerGrid" 
                                          Grid.Column="1"
                                          Grid.Row="4" 
                                          Height="Auto" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="ForegroundColorPickerPanel" 
                                              Margin="4,0,0,0" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Label x:Name="ForegroundColorPickerLabel"
                                                   Width="75"/>
                                            <syncfusion:ColorPicker x:Name="ForegroundColorPicker" 
                                                                    Grid.Column="1"  
                                                                    Width="37" 
                                                                    Height="20"
                                                                    Margin="5,0,0,0" 
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    GradientBrushDisplayMode="Extended"
                                                                    Style="{StaticResource SyncfusionAppointmentEditorColorPickerForegroundStyle}"
                                                                    HeaderTemplate="{StaticResource SyncfusionSchedulerColorPickerHeaderTemplate}" />
                                        </Grid>
                                        <Grid x:Name="BackgroundColorPickerPanel" 
                                              Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Label x:Name="BackgroundColorPickerLabel" 
                                                   Width="75"/>
                                            <syncfusion:ColorPicker x:Name="BackgroundColorPicker" 
                                                                    Grid.Column="1"  
                                                                    Width="37" 
                                                                    Height="20" 
                                                                    Margin="5,0,0,0"
                                                                    HorizontalAlignment="Left" 
                                                                    VerticalAlignment="Center"
                                                                    GradientBrushDisplayMode="Extended"
                                                                    Style="{StaticResource SyncfusionAppointmentEditorColorPickerBackgroundStyle}"
                                                                    HeaderTemplate="{StaticResource SyncfusionSchedulerColorPickerHeaderTemplate}" />
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <Grid x:Name="TimeZoneGrid" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Label x:Name="StartTimezoneLabel" Margin="8,8,0,0" />

                                    <Label x:Name="EndTimezoneLabel" Grid.Column="1" Margin="3,8,12,0" />

                                    <syncfusion:ComboBoxAdv x:Name="StartTimeZoneComboBox" 
                                                            Grid.Row="1" 
                                                            Width="238" 
                                                            Height="24" 
                                                            HorizontalAlignment="Left" 
                                                            Margin="14,0,0,8"
                                                            SelectedIndex="0"
                                                            ItemTemplate="{StaticResource SyncfusionSchedulerComboBoxItemTemplate}">

                                    </syncfusion:ComboBoxAdv>
                                    <syncfusion:ComboBoxAdv x:Name="EndTimeZoneComboBox" 
                                                            Grid.Row="1"
                                                            Grid.Column="1"  
                                                            Width="238" Height="24" 
                                                            HorizontalAlignment="Left" 
                                                            ItemTemplate="{StaticResource SyncfusionSchedulerComboBoxItemTemplate}"
                                                            Margin="9,0,12,8"
                                                            SelectedIndex="0"/>
                                </Grid>

                                <Grid Name="RecurrenceTypeGrid" VerticalAlignment="Stretch" Height="Auto">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <Label x:Name="RepeatLabel"
                                               Margin="8,8,0,0" />
                                        <syncfusion:ComboBoxAdv x:Name="RecurrenceTypesComboBox" 
                                                                Grid.Row="1" VerticalAlignment="Top"
                                                                Width="238" Height="24" 
                                                                ItemTemplate="{StaticResource SyncfusionSchedulerComboBoxItemTemplate}"
                                                                HorizontalAlignment="Left" 
                                                                Margin="14,0,0,4">
                                        </syncfusion:ComboBoxAdv>
                                    </Grid>

                                    <Grid x:Name="RepeatEveryIntervalGrid" Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <Label x:Name="RepeatEveryLabel" Margin="2,8,12,0" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" >
                                            <syncfusion:UpDown  x:Name="EveryIntervalGapNumberBox" 
                                                                IsScrollingOnCircle="True"
                                                                MaxValue="100"
                                                                MinValue="1"
                                                                NumberDecimalDigits="0"
                                                                Step="1"
                                                                Height="24"
                                                                VerticalAlignment="Top"
                                                                Width="112"
                                                                Margin="8,0,0,0"/>
                                            <Label x:Name="RecurrenceIntervalLabel" 
                                                   Margin="0,0,12,0"
                                                   HorizontalAlignment="Left" 
                                                   HorizontalContentAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="RecurrenceEndRangeGrid" Grid.Row="1" Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label x:Name="RecurrenceEndLabel"
                                               HorizontalAlignment="Left"/>
                                        <syncfusion:ComboBoxAdv x:Name="EndRecurrenceRangeComboBox" 
                                                                Grid.Row="1"
                                                                HorizontalAlignment="Left"
                                                                Margin="6,0,0,0" 
                                                                VerticalAlignment="Top" 
                                                                Width="112"
                                                                Height="24" 
                                                                ItemTemplate="{StaticResource SyncfusionSchedulerComboBoxItemTemplate}"/>
                                        <syncfusion:SfDatePicker x:Name="EndRecurrenceDatePicker"
                                                                 Grid.Row="1"  
                                                                 Grid.Column="1"
                                                                 VerticalAlignment="Top"
                                                                 Height="24"
                                                                 Width="112"
                                                                 Margin="5,0,8,0"
                                                                 Visibility="Collapsed"/>
                                        <syncfusion:UpDown  x:Name="EndRecurrenceNumberBox" 
                                                            VerticalAlignment="Top"
                                                            Grid.Column="1"
                                                            Grid.Row="1" 
                                                            IsScrollingOnCircle="True"
                                                            MaxValue="112"
                                                            MinValue="1"
                                                            NumberDecimalDigits="0"  
                                                            Step="1"
                                                            Width="112"
                                                            Height="24" 
                                                            Margin="5,0,8,0"
                                                            Visibility="Visible"/>
                                    </Grid>
                                    <Grid x:Name="WeeklyRecurrenceGrid" Grid.Row="1"
                                                                        Grid.RowSpan="2" 
                                                                        VerticalAlignment="Bottom" 
                                                                        Visibility="Visible">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Label x:Name="WeeklyRepeatOnLabel"
                                               Margin="8,0,0,0"  />
                                        <syncfusion:ComboBoxAdv x:Name="WeekDaysComboBox"
                                                                Width="238"
                                                                Grid.Row="1"
                                                                IsEditable="True"
                                                                Height="24"  
                                                                Margin="14,0,0,0" 
                                                                ItemTemplate="{StaticResource SyncfusionSchedulerComboBoxItemTemplate}"
                                                                HorizontalAlignment="Left" 
                                                                AllowMultiSelect="True"/>
                                    </Grid>
                                    
                                    <Grid x:Name="MonthlyRecurrenceGrid" 
                                          Grid.Row="1" 
                                          Grid.RowSpan="2" 
                                          Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Label x:Name="MonthlyRepeatOnLabel" 
                                               Margin="8,4,0,0" 
                                               VerticalContentAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" 
                                                    Grid.Row="1">
                                            <RadioButton x:Name="IsSpecificDayOfMonthRadioButton"
                                                         GroupName="SpecificMonth" 
                                                         Margin="14,1,12,0"
                                                         IsChecked="True" 
                                                         HorizontalContentAlignment="Center"
                                                         HorizontalAlignment="Right" 
                                                         AutomationProperties.Name="Specific month day"/>
                                            <syncfusion:UpDown  x:Name="EveryDayOfMonthNumberBox"
                                                                IsScrollingOnCircle="True"
                                                                MaxValue="31"
                                                                MinValue="1"
                                                                NumberDecimalDigits="0"
                                                                Step="1" 
                                                                Height="24"             
                                                                Width="169" 
                                                                Margin="14,0,12,8"
                                                                IsEnabled="{Binding IsChecked, ElementName=IsSpecificDayOfMonthRadioButton,Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" 
                                                    Grid.Row="2">
                                            <RadioButton x:Name="IsSpecificMonthWeekRadioButton" 
                                                         GroupName="SpecificMonth" 
                                                         Margin="14,1,0,1"
                                                         HorizontalContentAlignment="Center"/>
                                            <syncfusion:ComboBoxAdv x:Name="WeekNumberOfMonthComboBox"
                                                                    Width="103" 
                                                                    Margin="6,1,0,1" 
                                                                    Height="24"
                                                                    ItemTemplate="{StaticResource SyncfusionSchedulerComboBoxItemTemplate}"
                                                                    IsEnabled="{Binding IsChecked,ElementName=IsSpecificMonthWeekRadioButton,Mode=TwoWay}"/>
                                            <syncfusion:ComboBoxAdv x:Name="MonthWeekComboBox" 
                                                                    Width="103"
                                                                    Margin="9,0,0,0"
                                                                    Height="24" 
                                                                    ItemTemplate="{StaticResource SyncfusionSchedulerComboBoxItemTemplate}"
                                                                    IsEnabled="{Binding IsChecked,ElementName=IsSpecificMonthWeekRadioButton,Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="YearlyRecurrenceGrid"
                                          Grid.Row="1" 
                                          Grid.RowSpan="3" 
                                          Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Label x:Name="YearlyRepeatOnLabel"
                                               Margin="8,2,0,0"
                                               VerticalContentAlignment="Center" />
                                        <syncfusion:ComboBoxAdv x:Name="YearSpecificMonthComboBox" 
                                                                Grid.Row="1" 
                                                                ItemTemplate="{StaticResource SyncfusionSchedulerComboBoxItemTemplate}"
                                                                HorizontalAlignment="Left" 
                                                                Width="238" 
                                                                Height="24"
                                                                Margin="14,0,0,8"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Grid.Row="2" 
                                                    Margin="0,5,0,0">
                                            <RadioButton x:Name="IsSpecificMonthDayOnYearRadioButton"
                                                         GroupName="SpecificYear"
                                                         Margin="12,1,12,4"
                                                         HorizontalContentAlignment="Center"
                                                         IsChecked="True" 
                                                         HorizontalAlignment="Left"
                                                         AutomationProperties.Name="Specific month day"/>
                                            <syncfusion:UpDown  x:Name="EveryMonthDayOnYearNumberBox"
                                                                IsScrollingOnCircle="True"
                                                                MaxValue="31"
                                                                MinValue="1"
                                                                NumberDecimalDigits="0"
                                                                Step="1"
                                                                Height="24"                     
                                                                Width="174"
                                                                Margin="12,0,12,8"
                                                               IsEnabled="{Binding IsChecked,ElementName=IsSpecificMonthDayOnYearRadioButton,Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" 
                                                    Grid.Row="3" 
                                                    Margin="0,5,0,0">
                                            <RadioButton x:Name="IsSpecificMonthWeekOnYearRadioButton" 
                                                         GroupName="SpecificYear" 
                                                         Margin="12,0,0,0" 
                                                         HorizontalContentAlignment="Center"
                                                         AutomationProperties.Name="Specific month week"/>
                                            <syncfusion:ComboBoxAdv x:Name="WeekNumberOfMonthYearComboBox"
                                                                    Margin="6,0,0,0" 
                                                                    ItemTemplate="{StaticResource SyncfusionSchedulerComboBoxItemTemplate}"
                                                                    Height="24"
                                                                    Width="103"
                                                                    IsEnabled="{Binding IsChecked,ElementName=IsSpecificMonthWeekOnYearRadioButton,Mode=TwoWay}"/>
                                            <syncfusion:ComboBoxAdv x:Name="MonthWeekOnYearComboBox" 
                                                                    Margin="11,0,0,0" 
                                                                    ItemTemplate="{StaticResource SyncfusionSchedulerComboBoxItemTemplate}"
                                                                    Height="24" 
                                                                    Width="103"
                                                                    IsEnabled="{Binding IsChecked,ElementName=IsSpecificMonthWeekOnYearRadioButton,Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <Grid Name="Reminder" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button x:Name="AddReminderButton"
                                            Margin="14,0,0,0" 
                                            Style="{StaticResource SyncfusionAppointmentEditorPrimaryButtonStyle}"
                                            Height="24"
                                            Width="110"
                                            VerticalAlignment="Top" 
                                            HorizontalAlignment="Left"
                                            Grid.Row="1" />

                                    <ListView x:Name="ReminderList"
                                              HorizontalAlignment="Left"
                                              Grid.Row="0"
                                              ItemContainerStyle="{StaticResource SyncfusionSchedulerReminderListViewItemStyle}"
                                              Margin="7, 8, 0, 8" 
                                              Background="Transparent"
                                              BorderThickness="0"
                                              BorderBrush="Transparent">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel x:Name="ReminderStack" 
                                                            Orientation="Horizontal" 
                                                            Margin="3,0,0,0"
                                                            Background="Transparent">
                                                    <syncfusion:UpDown x:Name="ReminderTimeInterval"
                                                                       Margin="5,0,0,0" 
                                                                       Height="24"
                                                                       Width="100" 
                                                                       IsScrollingOnCircle="True"
                                                                       MinValue="0"
                                                                       Step="1" 
                                                                       NumberDecimalDigits="0"
                                                                       Value="{Binding Converter={StaticResource ReminderTimeIntervalConverter}, Path=ReminderTimeInterval, Mode=OneWay, ConverterParameter=TimeInterval}"/>
                                                    <syncfusion:ComboBoxAdv x:Name="ReminderTimeIntervalMenu" 
                                                                            ItemTemplate="{StaticResource SyncfusionSchedulerComboBoxItemTemplate}"
                                                                            Margin="8, 0, 0, 0" 
                                                                            Width="98"
                                                                            Height="24"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Center"
                                                                            SelectedIndex="{Binding Converter={StaticResource ReminderTimeIntervalConverter}, Path=ReminderTimeInterval, Mode=OneWay, ConverterParameter=TimeIntervalMenu}" />

                                                    <Button Height="24" x:Name="RemoveReminder"
                                                                        Style="{StaticResource SyncfusionAppointmentEditorGlyphButtonStyle}"
                                                                        Width="25"
                                                                        Margin="6,0,0,0">
                                                        <Path Stretch="Uniform" 
                                                              Width="10" 
                                                              Height="10" 
                                                              Margin="0"  
                                                              Style="{StaticResource SyncfusionReminderCloseButtonStyle}"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <TransformGroup>
                                                                    <TransformGroup.Children>
                                                                        <RotateTransform Angle="0" />
                                                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                                                    </TransformGroup.Children>
                                                                </TransformGroup>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>

                                <Grid Name="ResourceGrid" Height="Auto" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Label x:Name="ResourceLabel"
                                           Margin="8,8,0,0" 
                                           Grid.Row="0"
                                           VerticalAlignment="Top"/>
                                    <syncfusion:ComboBoxAdv x:Name="ResourceComboBox" 
                                                            Height="24"
                                                            Margin="14,0,6,0" 
                                                            Grid.Row="1" 
                                                            AllowMultiSelect="True"
                                                            Width="494" 
                                                            HorizontalAlignment="Left">
                                        <syncfusion:ComboBoxAdv.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Height="24" Padding="2,4,4,4" Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </syncfusion:ComboBoxAdv.ItemTemplate>
                                    </syncfusion:ComboBoxAdv>
                                </Grid>
                                <StackPanel x:Name="NotesPanel"
                                            Orientation="Vertical"
                                            Height="Auto">
                                    <Label x:Name="DescriptionLabel" 
                                           Margin="8,8,0,0"  />
                                    <TextBox x:Name="NotesTextBox" 
                                             Margin="14,4,6,0"
                                             HorizontalAlignment="Left" 
                                             VerticalAlignment="Center" 
                                             Height="40"
                                             Width="494" 
                                             VerticalScrollBarVisibility="Auto"
                                             TextWrapping="Wrap" 
                                             AcceptsReturn="True"
                                             AutomationProperties.Name="Description"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Height="Auto" Background="Transparent" Grid.Row="1" Margin="0, 8, 0, 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="233"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DeleteAppointmentButton"  
                                    Margin="-20,0,0,0"
                                    Width="70" 
                                    Height="24" 
                                    Visibility="Collapsed" 
                                    Style="{StaticResource SyncfusionAppointmentEditorFlatButtonStyle}"/>
                            <Button x:Name="SaveAppointmentButton" 
                                    Grid.Column="2"
                                    Width="70" 
                                    Height="24"
                                    IsDefault="True" 
                                    Style="{StaticResource SyncfusionAppointmentEditorPrimaryButtonStyle}"/>
                            <Button x:Name="CancelAppointmentButton" 
                                    Grid.Column="3"
                                    Width="70" 
                                    Height="24" 
                                    IsCancel="True" 
                                    Style="{StaticResource SyncfusionAppointmentEditorFlatButtonStyle}"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
