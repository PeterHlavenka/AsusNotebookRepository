    <Style x:Key="SyncfusionSchedulerReminderNotificationControlStyle" TargetType="scheduler:ReminderNotificationControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="scheduler:ReminderNotificationControl">
                    <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="80" />
                          <RowDefinition Height="190" />
                          <RowDefinition Height="80" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="NoReminder" 
                                   Grid.Row="0"
                                   Margin="40,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="Medium"
                                   Visibility="Collapsed"/>

                       <Grid Margin="12,5,12,0" 
                             x:Name="ReminderHeader"
                             Grid.Row="0">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="HeaderSubject"
                                       VerticalAlignment="Bottom"
                                       FontSize="20"/>
                            <TextBlock x:Name="HeaderTime"
                                       Grid.Row="1"
                                       FontSize="12"
                                       Margin="1,5,0,0"
                                       VerticalAlignment="Top"/>
                            <TextBlock x:Name="HeaderLocation"
                                       Grid.Row="2"
                                       Margin="0,5,0,0"
                                       FontSize="14"
                                       VerticalAlignment="Top" />
                        </Grid>

                        <ListView x:Name="ReminderList"
                                  Grid.Row="1"
                                  Margin="12,12,12,0" 
                                  SelectedIndex="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  BorderThickness="1" 
                                  ItemsSource="{Binding Reminders}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="24" 
                                          Margin="0" 
                                          Width="470">
                                        <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="235" />
                                          <ColumnDefinition Width="205" />
                                          <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Margin="6, 0, 0, 0"
                                                   x:Name="ReminderSubject"
                                                   FontWeight="Medium"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Appointment.Subject}"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="12, 0, 0, 0"
                                                   x:Name="ReminderDeliveryTime"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" 
                                                   FontSize="12"
                                                   Text="{Binding Converter={StaticResource reminderTimeConverter}}"
                                                   IsEnabled="False"/>
                                        <Button Height="20" 
                                                Style="{StaticResource SyncfusionAppointmentEditorGlyphButtonStyle}"                               
                                                Width="Auto" 
                                                Background="Transparent" 
                                                HorizontalAlignment="Right" 
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}, Converter={StaticResource booleanToVisibilityConverter}}"
                                                Grid.Column="2">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                   <TextBlock  Text="{scheduler:SchedulerLocalizationResourceExtension ResourceName=Dismiss}" Background="Transparent" />
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <Path Style="{StaticResource SyncfusionReminderCloseButtonStyle}"
                                                  Stretch="Uniform" 
                                                  Fill="{Binding Path=Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                  Width="10" 
                                                  Height="10" 
                                                  Margin="0" 
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <TransformGroup>
                                                        <TransformGroup.Children>
                                                            <RotateTransform Angle="0" />
                                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                                        </TransformGroup.Children>
                                                    </TransformGroup>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Path=Appointment.Subject}" Value="{x:Static sys:String.Empty}">
                                           <Setter TargetName="ReminderSubject" Property="TextBlock.Text" Value="{scheduler:SchedulerLocalizationResourceExtension ResourceName=EmptyAppointmentSubject}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid Grid.Row="3" 
                              Margin="12"
                              IsEnabled="{Binding ElementName=ReminderHeader, Path=IsVisible}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="200" />
                              <ColumnDefinition Width="178" />
                              <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ClickSnooze"
                                       Grid.Row="0"
                                       FontSize="12"
                                       Grid.Column="0"
                                       FontWeight="Medium"
                                       Margin="0,0,4,0"/>
                            <syncfusion:ComboBoxAdv x:Name="Snooze"
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    SelectedIndex="0"
                                                    Width="190"
                                                    Margin="0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center" 
                                                    Height="22" />
                            <Button x:Name="SetSnooze"
                                    Style="{StaticResource SyncfusionEditorFlatButtonStyle}"
                                    Grid.Row="1"
                                    Grid.Column="1" 
                                    HorizontalAlignment="Left"
                                    Width="100" 
                                    Grid.ColumnSpan="2" />
                            <Button x:Name="DismissAll"
                                    Style="{StaticResource SyncfusionEditorFlatButtonStyle}"
                                    Grid.Column="2"
                                    Grid.Row="1"
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    Grid.RowSpan="2" 
                                    IsCancel="True"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
           </Setter.Value>
        </Setter>
    </Style>
