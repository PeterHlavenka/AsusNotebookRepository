<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bulletGraph="clr-namespace:Syncfusion.UI.Xaml.BulletGraph;assembly=Syncfusion.SfBulletGraph.WPF"
                    xmlns:themelocal="clr-namespace:Syncfusion.Themes.Windows11TealLightTheme.WPF"
                    xmlns:sfskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.SfBulletGraph.WPF;component/Themes/Generic.xaml"/>
        <sfskin:ResourceDictionaryProvider DictionaryName="Common" ThemeName="Windows11TealLightTheme"/>
        <sfskin:ResourceDictionaryProvider DictionaryName="Brushes" ThemeName="Windows11TealLightTheme"/>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="DefaultToolTipTemplate">
        <Border  x:Name="ToolTipBorder"
                 BorderBrush="{StaticResource TooltipBorder}"
                 BorderThickness="1"
                 Background="{StaticResource TooltipBackground}"
                 Effect="{StaticResource Default.ShadowDepth3}"
                 CornerRadius="{StaticResource Windows11TealLightTheme.CornerRadius4}">
            <Border.Margin>
                <Thickness>4,0,4,4</Thickness>
            </Border.Margin>
            <TextBlock x:Name="ToolTipText"
                       Text="{Binding}"
                       FontSize="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=CaptionText}}"
                       Foreground="{StaticResource TooltipForeground}"
                       Margin="12 8" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DefaultQualitativeRangeToolTipTemplate">
        <Border x:Name="QualitativeRangeToolTipBorder"
                BorderBrush="{StaticResource Series10}"
                BorderThickness="{StaticResource Windows11TealLightTheme.BorderThickness}"
                Effect="{StaticResource Default.ShadowDepth3}"
                CornerRadius="{StaticResource Windows11TealLightTheme.CornerRadius4}"
                Background="{Binding RangeStroke}">
            <Border.Margin>
                <Thickness>6,0,6,6</Thickness>
            </Border.Margin>
            <StackPanel Orientation="Horizontal"
                            Margin="12 8">
                    <TextBlock Text="{Binding Caption}"
                               FontSize="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=CaptionText}}"
                               Foreground="{StaticResource TooltipForeground}" />
                    <TextBlock Text="{Binding RangeStart}"
                               FontSize="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=CaptionText}}"
                               Foreground="{StaticResource TooltipForeground}" />
                    <TextBlock Text="-"
                               FontSize="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=CaptionText}}"
                               Foreground="{StaticResource TooltipForeground}"
                               Width="10"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding RangeEnd}"
                               FontSize="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=CaptionText}}"
                               Foreground="{StaticResource TooltipForeground}" />
                </StackPanel>
        </Border>
    </DataTemplate>

    <Style x:Key="SyncfusionSfBulletGraphStyle"
           TargetType="bulletGraph:SfBulletGraph" BasedOn="{StaticResource SfBulletGraphStyle}">
        <Setter Property="Background"
                Value="Transparent"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource BorderAlt}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <Setter Property="Foreground"
                Value="{StaticResource ContentForeground}"/>
        <Setter Property="ComparativeMeasureSymbolStroke"
                Value="{StaticResource Series10}"/>
        <Setter Property="FeaturedMeasureBarStroke"
                Value="{StaticResource Series10}"/>
        <Setter Property="Template" Value="{StaticResource DefaultHorizontalTemplate}"/>
        <Setter Property="LabelTemplate" Value="{StaticResource DefaultLabelTemplate}"/>
        <Setter Property="MajorTickStroke"
                Value="{StaticResource BorderAlt1}"/>
        <Setter Property="MinorTickStroke"
                Value="{StaticResource BorderAlt1}"/>
        <Setter x:Name="LabelStroke"
                Property="LabelStroke"
                Value="{StaticResource ContentForeground}"/>
        <Setter Property="FeaturedMeasureToolTipTemplate"
                Value="{StaticResource DefaultToolTipTemplate}" />
        <Setter Property="ComparativeMeasureToolTipTemplate"
                Value="{StaticResource DefaultToolTipTemplate}" />
        <Setter Property="QualitativeRangeToolTipTemplate"
                Value="{StaticResource DefaultQualitativeRangeToolTipTemplate}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=ThemeFontFamily}}"/>
        <Setter Property="FontWeight"
                Value="{StaticResource Windows11TealLightTheme.FontWeightNormal}"/>
        <Setter Property="FontSize"
                Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=CaptionText}}"/>
        <Setter Property="LabelSize"
                Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=CaptionText}}"/>
    </Style>

    <Style x:Key="SyncfusionSfBulletGraphQualitativeRangeStyle"
           TargetType="bulletGraph:QualitativeRange">
        <Setter Property="RangeStroke"
                Value="{StaticResource Series6}" />
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="bulletGraph:QualitativeRange">
                    <Rectangle ToolTipService.Placement="Mouse"
                               Width="{TemplateBinding Width}"
                               Height="{TemplateBinding Height}"
                               Fill="{Binding RangeStroke, RelativeSource={RelativeSource TemplatedParent}}" 
                               Opacity="{Binding RangeOpacity, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToolTipService.ToolTip>
                            <ToolTip x:Name="PART_RangeToolTip"
                                     Style="{StaticResource ToolTipStyle}"
                                     ContentTemplate="{Binding ToolTipTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                     Visibility="{Binding ToolTipVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="bulletGraph:SfBulletGraph"           BasedOn="{StaticResource SyncfusionSfBulletGraphStyle}" />
    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Control=Syncfusion.UI.Xaml.BulletGraph.SfBulletGraph}" TargetType="bulletGraph:SfBulletGraph"           BasedOn="{StaticResource SyncfusionSfBulletGraphStyle}" />

    <Style TargetType="bulletGraph:QualitativeRange"           BasedOn="{StaticResource SyncfusionSfBulletGraphQualitativeRangeStyle}" />
    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Control=Syncfusion.UI.Xaml.BulletGraph.QualitativeRange}" TargetType="bulletGraph:QualitativeRange"           BasedOn="{StaticResource SyncfusionSfBulletGraphQualitativeRangeStyle}" />

</ResourceDictionary>
