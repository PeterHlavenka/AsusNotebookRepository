<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.SfSpellChecker.Wpf"
                    xmlns:spellchecker="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.SfSpellChecker.Wpf"
                    xmlns:sfskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
                    xmlns:themelocal="clr-namespace:Syncfusion.Themes.Windows11TealLightTheme.WPF">

    <ResourceDictionary.MergedDictionaries>
        <sfskin:ResourceDictionaryProvider DictionaryName="Common" ThemeName="Windows11TealLightTheme"/>
        <sfskin:ResourceDictionaryProvider DictionaryName="Brushes" ThemeName="Windows11TealLightTheme"/>
        <ResourceDictionary Source="/Syncfusion.Themes.Windows11TealLightTheme.WPF;component/MSControl/Button.xaml" />
        <ResourceDictionary Source="/Syncfusion.Themes.Windows11TealLightTheme.WPF;component/MSControl/TextBox.xaml" />
        <ResourceDictionary Source="/Syncfusion.Themes.Windows11TealLightTheme.WPF;component/MSControl/RichTextBox.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="SyncfusionSpellCheckerWindowStyle" TargetType="{x:Type local:SpellCheckerDialog}">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ContentForeground}"/>
        <Setter Property="FontFamily" Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=ThemeFontFamily}}"/>
        <Setter Property="FontWeight" Value="{StaticResource Windows11TealLightTheme.FontWeightNormal}"/>
        <Setter Property="FontSize" Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=BodyTextStyle}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SpellCheckerDialog}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="125" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                         Margin="5,5,2,8"
                         VerticalAlignment="Center"
                         FontSize="13"
                         Text="{spellchecker:SpellCheckerLocalizationResource ResourceName=NotInDictionaryText}" />
                        <RichTextBox
                         x:Name="richText"
                         Grid.Row="1"
                         Grid.RowSpan="3"
                         Margin="5,0,5,5"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" 
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        <TextBlock
                         Grid.Row="4"
                         Margin="5,3,2,8"
                         VerticalAlignment="Center"
                         FontSize="13"
                         Text="{spellchecker:SpellCheckerLocalizationResourceExtension ResourceName=SuggestionsText}" />
                        <ListBox
                         x:Name="lstBox"
                         Grid.Row="5"
                         Grid.RowSpan="3"
                         Margin="5,0,5,5"
                         BorderThickness="1"
                         ItemsSource="{Binding Suggestions, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        <Button
                         x:Name="ignore"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="30"
                         Margin="3,0,7,5"
                         Content="{spellchecker:SpellCheckerLocalizationResourceExtension ResourceName=IgnoreOnceText}" />
                        <Button
                         x:Name="ignoreAllBtn"
                         Grid.Row="2"
                         Grid.Column="1"
                         Height="30"
                         Margin="3,3,7,3"
                         Content="{spellchecker:SpellCheckerLocalizationResourceExtension ResourceName=IgnoreAllText}" />
                        <Button
                         x:Name="addToDic"
                         Grid.Row="3"
                         Grid.Column="1"
                         Height="30"
                         Margin="3,3,7,3"
                         IsEnabled="False"
                         Content="{spellchecker:SpellCheckerLocalizationResourceExtension ResourceName=AddToDictionaryText}" />
                        <Button
                         x:Name="replaceBtn"
                         Grid.Row="5"
                         Grid.Column="1"
                         Height="30"
                         Margin="3,0,7,5"
                         Content="{spellchecker:SpellCheckerLocalizationResourceExtension ResourceName=ReplaceText}" />
                        <Button
                         x:Name="replaceAllBtn"
                         Grid.Row="6"
                         Grid.Column="1"
                         Height="30"
                         Margin="3,3,7,3"
                         Content="{spellchecker:SpellCheckerLocalizationResourceExtension ResourceName=ReplaceAllText}" />
                        <Button
                         x:Name="closeBtn"
                         Grid.Row="7"
                         Grid.Column="1"
                         Height="30"
                         Margin="3,3,7,3"
                         Content="{spellchecker:SpellCheckerLocalizationResourceExtension ResourceName=CloseText}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource SyncfusionSpellCheckerWindowStyle}" TargetType="{x:Type local:SpellCheckerDialog}" />
    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Control=Syncfusion.Windows.Controls.SpellCheckerDialog}" BasedOn="{StaticResource SyncfusionSpellCheckerWindowStyle}" TargetType="{x:Type local:SpellCheckerDialog}" />
</ResourceDictionary>
