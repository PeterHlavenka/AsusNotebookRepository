<Window x:Class="BrushViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrushViewer"
        mc:Ignorable="d"
        Title="Brush Viewer" Height="800" Width="1200"
        Background="#FF202020">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="10" Orientation="Horizontal">
            <Button Name="LoadButton" Content="Load Brushes.xaml"
                    Width="150" Height="30" Click="LoadButton_Click"
                    Margin="0,0,10,0" />
            <TextBox Name="SearchBox"
                     Width="250" Height="30"
                     Margin="0,0,10,0"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"
                     FontSize="13"
                     Background="#FF303030"
                     Foreground="White"
                     BorderBrush="#FF505050"
                     Padding="5,0" />
            <TextBlock Text="🔍" VerticalAlignment="Center"
                       Foreground="#FF888888" Margin="0,0,10,0" FontSize="16" />
            <TextBlock Name="StatusText" VerticalAlignment="Center"
                       Foreground="White" Text="Klikněte pro načtení Brushes.xaml" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">
                <!-- Záhlaví sloupců -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Key"
                               Foreground="#FFAAAAAA"
                               FontFamily="Consolas"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="5,0" />

                    <TextBlock Grid.Column="1"
                               Text="Dark Theme"
                               Foreground="#FFAAAAAA"
                               FontFamily="Consolas"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="5,0" />

                    <TextBlock Grid.Column="2"
                               Text="Light Theme"
                               Foreground="#FFAAAAAA"
                               FontFamily="Consolas"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="5,0" />
                </Grid>

                <!-- Seznam barev -->
                <ListBox Name="BrushList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="BrushList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="#FF404040"
                                                BorderThickness="0,0,0,1"
                                                Padding="5" Margin="0,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FF404040" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF303030" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="400" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Key}"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           Cursor="Hand"
                                           ToolTip="Klikněte pro zkopírování do schránky"
                                           MouseLeftButtonDown="CopyKeyToClipboard" />

                                <!-- Dark Theme -->
                                <Border Grid.Column="1"
                                        Background="{Binding Dark.Brush}"
                                        Width="60" Height="30"
                                        BorderBrush="White" BorderThickness="1"
                                        Margin="5,0" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Dark.ColorHex}"
                                           Foreground="#FFC8C8C8"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="11" />

                                <!-- Light Theme -->
                                <Border Grid.Column="3"
                                        Background="{Binding Light.Brush}"
                                        Width="60" Height="30"
                                        BorderBrush="White" BorderThickness="1"
                                        Margin="5,0" />

                                <TextBlock Grid.Column="4"
                                           Text="{Binding Light.ColorHex}"
                                           Foreground="#FFC8C8C8"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="11" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
        <!-- Pravý panel s náhledem -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Dark Theme - horní polovina -->
            <Grid Grid.Row="0" Background="Black">
                <StackPanel Margin="15" VerticalAlignment="Center">
                    <TextBlock Name="PreviewKeyText"
                               Text="Vyberte barvu"
                               Foreground="White"
                               FontFamily="Consolas"
                               FontSize="16"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="Dark Theme"
                               Foreground="#FFAAAAAA"
                               FontFamily="Consolas"
                               FontSize="12"
                               Margin="0,0,0,5" />
                    <Border Name="PreviewDark"
                            Background="Transparent"
                            Height="150"
                            Margin="0,0,0,5" />
                    <TextBlock Name="PreviewDarkHex"
                               Text=""
                               Foreground="#FFC8C8C8"
                               FontFamily="Consolas"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Light Theme - dolní polovina -->
            <Grid Grid.Row="1" Background="White">
                <StackPanel Margin="15" VerticalAlignment="Center">
                    <TextBlock Text="Light Theme"
                               Foreground="#FF555555"
                               FontFamily="Consolas"
                               FontSize="12"
                               Margin="0,0,0,5" />
                    <Border Name="PreviewLight"
                            Background="Transparent"
                            Height="150"
                            Margin="0,0,0,5" />
                    <TextBlock Name="PreviewLightHex"
                               Text=""
                               Foreground="#FF333333"
                               FontFamily="Consolas"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>