<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <Page Update="ListBoxFromSfThemeCustomizerProject.xaml">
            <SubType>Designer</SubType>
            <Generator>MSBuild:Compile</Generator>
        </Page>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Syncfusion.Licensing"/>
        <PackageReference Include="Syncfusion.Shared.WPF"/>
        <PackageReference Include="Syncfusion.Themes.Windows11Light.WPF"/>
        <PackageReference Include="Syncfusion.Themes.Windows11Dark.WPF"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Src\UI\Images\Images.csproj" />
        <ProjectReference Include="..\..\..\Src\UI\SyncfusionLicenceRegistrator\SyncfusionLicenceRegistrator.csproj" />
        <ProjectReference Include="..\..\..\Src\UI\SyncfusionThemeRegistrator\SyncfusionThemeRegistrator.csproj" />
        <ProjectReference Include="..\..\..\Src\UI\UserInterface.Wpf\UserInterface.Wpf.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Syncfusion.Themes.Windows11MintDark.WPF">
            <HintPath>..\..\Syncfusion.Themes.Windows11MintDark.WPF.dll</HintPath>
        </Reference>
        <Reference Include="Syncfusion.Themes.Windows11MintLight.WPF">
            <HintPath>..\..\Syncfusion.Themes.Windows11MintLight.WPF.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>
