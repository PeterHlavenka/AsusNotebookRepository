<UserControl x:Class="ComponentCustomizer.ListBoxFromSfThemeCustomizerProject"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:images="clr-namespace:Adwind.UI.Images;assembly=Adwind.UI.Images"
             xmlns:componentCustomizer="clr-namespace:ComponentCustomizer"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance componentCustomizer:ListBoxFromSfThemeCustomizerProject, IsDesignTimeCreatable=True}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Origin" />

        <ListBox Name="Origin"
                 Grid.Row="1" Grid.Column="0"
                 MinWidth="180"
                 Height="750"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 SelectedItem="{Binding SelectedItem, Mode=OneWayToSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <images:SvgControl
                            Name="SvgControl"
                            AppName="Adwind.UI.Images"
                            Source="{Binding MySource}"
                            Width="16"
                            Height="16"
                            Margin="0,0,20,0"
                            HorizontalAlignment="Left"
                            d:DataContext="{d:DesignInstance componentCustomizer:ListBoxItemWithSvgSource}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Name}"
                            d:DataContext="{d:DesignInstance componentCustomizer:ListBoxItemWithSvgSource}"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="Customized" />

        <ListBox Grid.Row="1" Grid.Column="1" Name="Customized"
                 MinWidth="180"
                 Height="750"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 SelectedItem="{Binding SelectedItem, Mode=OneWayToSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <images:SvgControl
                            Name="SvgControl"
                            AppName="Adwind.UI.Images"
                            Source="{Binding MySource}"
                            CustomizeMode="PredefinedColor"
                            Width="32"
                            Height="32"
                            Margin="0,0,20,0"
                            HorizontalAlignment="Left"
                            d:DataContext="{d:DesignInstance componentCustomizer:ListBoxItemWithSvgSource}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Name}"
                            d:DataContext="{d:DesignInstance componentCustomizer:ListBoxItemWithSvgSource}"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="0" Grid.Column="2" Text="Preview" />

        <Grid Grid.Row="1" Grid.Column="2" Height="750">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            
            <images:SvgControl
                Grid.Row="0" Name="Preview"
                AppName="Adwind.UI.Images"
                Margin="20" 
                VerticalAlignment="Top"/>

            <images:SvgControl
                Grid.Row="1" Name="PreviewCustomized"
                AppName="Adwind.UI.Images"
                Margin="20" 
                VerticalAlignment="Top"/>
        </Grid>

    </Grid>
</UserControl>