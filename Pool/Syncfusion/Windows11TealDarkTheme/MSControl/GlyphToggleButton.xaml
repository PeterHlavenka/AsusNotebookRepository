<Style x:Key="{sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealDarkThemeSkinHelper}, Key=WPFGlyphTextToggleButtonStyle}" BasedOn="{StaticResource WPFGlyphTextToggleButtonStyle}" TargetType="{x:Type ToggleButton}"/>
</ResourceDictionary>
