    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealDarkThemeSkinHelper}, Control=Syncfusion.UI.Xaml.Diagram.SfDiagram}" TargetType="diagram:SfDiagram" BasedOn="{StaticResource SyncfusionSfDiagramStyle}"/>

    <Style TargetType="diagram_localControls:Overview" x:Key="SyncfusionOverviewStyle">
        <Setter Property="HorizontalContentAlignment"
                Value="Center"/>
        <Setter Property="VerticalContentAlignment"
                Value="Center"/>
        <Setter Property="Background"
                Value="Transparent"/>
        <Setter Property="FocusBrush"
                Value="{StaticResource ContentBackgroundHovered}"/>
        <Setter Property="UnFocusBrush" 
                Value="{StaticResource Overlay}"/>
