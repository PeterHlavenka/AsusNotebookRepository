                                                                        <ControlTemplate>
                                                                            <Border Background="Transparent"/>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Thumb.Style>
                                                    </Thumb>
                                                </Grid>
                                            </diagram_localControls:OverviewResizer.Content>
                                        </diagram_localControls:OverviewResizer>
                                    </diagram_panels:OverviewCustomPanel>
