    <Style TargetType="diagram_localControls:RulerSegment" BasedOn="{StaticResource SyncfusionRulerSegmentStyle}"/>
    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealDarkThemeSkinHelper}, Control=Syncfusion.UI.Xaml.Diagram.Controls.RulerSegment}" TargetType="diagram_localControls:RulerSegment" BasedOn="{StaticResource SyncfusionRulerSegmentStyle}"/>

    <Style TargetType="diagram:SfDiagram" x:Key="SyncfusionSfDiagramStyle">
