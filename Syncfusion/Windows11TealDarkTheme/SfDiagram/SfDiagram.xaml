    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealDarkThemeSkinHelper}, Control=Syncfusion.UI.Xaml.Diagram.Controls.ScrollViewer}" TargetType="diagram_localControls:ScrollViewer" BasedOn="{StaticResource SyncfusionDiagramScrollViewerStyle}"/>

