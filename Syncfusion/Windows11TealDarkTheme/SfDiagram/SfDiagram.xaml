                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Top" 
                                           Fill="Transparent" 
                                           Stroke="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealDarkThemeSkinHelper}, Key=PrimaryBackground}}" 
                                           StrokeDashArray="2,2" 
                                           StrokeThickness="1"/>
                                        <Rectangle x:Name="PART_ResizerPreview"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           RenderTransform="{TemplateBinding ViewportPosition}" 
                                           Fill="Transparent" 
