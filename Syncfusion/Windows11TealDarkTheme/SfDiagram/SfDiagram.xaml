    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealDarkThemeSkinHelper}, Control=Syncfusion.UI.Xaml.Diagram.Selector}" TargetType="diagram:Selector" BasedOn="{StaticResource SyncfusionSelectorStyle}"/>

