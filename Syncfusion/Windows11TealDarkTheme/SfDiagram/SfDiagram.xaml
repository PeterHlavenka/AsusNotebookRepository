                            <Setter TargetName="ellipse" Property="Fill" Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealDarkThemeSkinHelper}, Key=PrimaryColorLight1}}"/>
                            <Setter TargetName="ellipse" Property="Stroke" Value="{StaticResource ContentBackground}"/>
                        </Trigger>
                        <Trigger Property="IsMouseCaptured" Value="True">
                            <Setter TargetName="ellipse" Property="Fill" Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealDarkThemeSkinHelper}, Key=PrimaryColorLight2}}"/>
                            <Setter TargetName="ellipse" Property="Stroke" Value="{StaticResource ContentBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ellipse" Property="Fill" Value="{StaticResource ContentBackgroundAlt2}"/>
                            <Setter TargetName="ellipse" Property="Stroke" Value="{StaticResource ContentBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=ControlPointType, Converter={StaticResource OrthogonalControlPointToBooleanConverter}}" Value="True">
                <Setter Property="Shape" 
                        Value="{StaticResource Rectangle}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="diagram_localControls:DiagramThumb">
