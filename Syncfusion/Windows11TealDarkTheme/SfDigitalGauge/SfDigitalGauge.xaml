<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:themelocal="clr-namespace:Syncfusion.Themes.Windows11TealDarkTheme.WPF"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Syncfusion="clr-namespace:Syncfusion.UI.Xaml.Gauges;assembly=Syncfusion.SfGauge.WPF"
                    xmlns:sfskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.SfGauge.WPF;component/DigitalGauge/Themes/DigitalGauge.xaml"/>
        <sfskin:ResourceDictionaryProvider DictionaryName="Common" ThemeName="Windows11TealDarkTheme"/>
        <sfskin:ResourceDictionaryProvider DictionaryName="Brushes" ThemeName="Windows11TealDarkTheme"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SyncfusionSfDigitalGaugeStyle" TargetType="Syncfusion:SfDigitalGauge" BasedOn="{StaticResource SfDigitalGaugeStyle}">
        <Setter Property="Background"
                Value="Transparent"></Setter>
        <Setter Property="BorderBrush"
                Value="{StaticResource BorderAlt}"></Setter>
        <Setter Property="BorderThickness"
                Value="0"></Setter>
        <Setter Property="CharacterStroke"
                Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealDarkThemeSkinHelper}, Key=PrimaryBackground}}"></Setter>
        <Setter Property="DimmedBrush"
                Value="{StaticResource Series8}"></Setter>
    </Style>
    <Style BasedOn="{StaticResource SyncfusionSfDigitalGaugeStyle}" TargetType="Syncfusion:SfDigitalGauge" />
    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealDarkThemeSkinHelper}, Control=Syncfusion.UI.Xaml.Gauges.SfDigitalGauge}" BasedOn="{StaticResource SyncfusionSfDigitalGaugeStyle}" TargetType="Syncfusion:SfDigitalGauge" />
    
</ResourceDictionary>
