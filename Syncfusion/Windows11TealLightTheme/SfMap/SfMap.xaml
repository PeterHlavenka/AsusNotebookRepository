<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syncfusion="clr-namespace:Syncfusion.UI.Xaml.Maps;assembly=Syncfusion.SfMaps.WPF"
                    xmlns:themelocal="clr-namespace:Syncfusion.Themes.Windows11TealLightTheme.WPF"
                    xmlns:sfskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.SfMaps.WPF;component/Themes/Generic.xaml"/>
        <sfskin:ResourceDictionaryProvider DictionaryName="Common" ThemeName="Windows11TealLightTheme"/>
        <sfskin:ResourceDictionaryProvider DictionaryName="Brushes" ThemeName="Windows11TealLightTheme"/>
    </ResourceDictionary.MergedDictionaries>

    <syncfusion:MarginConverter x:Key="marginConverter"/>
    <syncfusion:BooleanToVisibilityConverter x:Key="visibilityConverter"/>

    <DataTemplate x:Key="ToolTipTemplate">
        <Border Effect="{StaticResource Default.ShadowDepth4}"
                Background="{StaticResource TooltipBackground}"
                BorderBrush="{StaticResource TooltipBorder}"
                BorderThickness="{StaticResource Windows11TealLightTheme.BorderThickness1}"
                CornerRadius="{StaticResource Windows11TealLightTheme.CornerRadius4}">
            <Border.Margin>
                <Thickness>14,0,14,14</Thickness>
            </Border.Margin>
            <!--The reason for handling collapse in tooltips is to restrict the appearance of the nose part between the mouse pointer and the tooltip popup-->
            <Grid>
                <Polygon Visibility="Collapsed" Fill="{StaticResource TooltipBackground}"
                         Points="{Binding PolygonPoints}"
                         Stroke="{StaticResource TooltipBorder}"
                         StrokeThickness="{Binding StrokeThickness}" />
                <Grid HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Value}"
                               FontSize="{Binding FontSize}"
                               Foreground="{StaticResource TooltipForeground}"
                               FontFamily="{Binding FontFamily}"
                               FontStyle="{Binding FontStyle}"
                               Padding="0"
                               Margin="{Binding Margin}" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ToolTipDataTemplate">
        <Border>
            <Grid>
                <Polygon Fill="{StaticResource TooltipBackground}"
                         Points="{Binding PolygonPoints}"
                         Stroke="{StaticResource TooltipBorder}"
                         StrokeThickness="{Binding StrokeThickness}" />
                <Grid HorizontalAlignment="Center">
                    <ContentPresenter ContentTemplate="{Binding TooltipTemplate}"
                                      Margin="{Binding Margin}"/>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <Style x:Key="SyncfusionSfMapStyle" TargetType="syncfusion:SfMap">
        <Setter Property="MapResourceDictionary">
            <Setter.Value>
                <ResourceDictionary Source="SfMap.xaml" />
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=ThemeFontFamily}}" />
        <Setter Property="FontSize" Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=HeaderTextStyle}}" />
        <Setter Property="FontWeight" Value="{StaticResource Windows11TealLightTheme.FontWeightNormal}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderAlt}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource ContentForeground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Padding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Padding}" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background}" BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}" BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderThickness}">
                        <Grid x:Name="PART_MapGrid" Background="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <ContentControl Grid.Row="1" Content="{Binding RelativeSource={RelativeSource TemplatedParent},Path=LayeredContent}" IsTabStop="False"/>
                            <syncfusion:NavigationControl Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" x:Name="PART_NavigationControl" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},Path=ShowNavigationControl,Mode=TwoWay,Converter={StaticResource visibilityConverter}}"/>
                            <Border Grid.Row="0">
                                <ContentPresenter x:Name="PART_HeaderGrid" Content="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Header}" />
                            </Border>
                            <Border Grid.Row="1">
                                <TextBlock x:Name="PART_MapCoords" IsHitTestVisible="False" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ShowCoords, Converter={StaticResource visibilityConverter}}" HorizontalAlignment="Right"/>
                            </Border>
                            <Popup x:Name="Part_BalloonPopup" AllowsTransparency="True">
                                <!--The control template is currently handled with hardcoded values based on the source style to support dynamic theme switching. The code was copied from the Maps source to replicate the existing UI. We now need to improve the UI by applying theme-based styles and updating mapping keys in excel sheets.-->
                                <Border BorderBrush="#7f000000" BorderThickness="1">
                                    <StackPanel Background="Transparent">
                                        <Button x:Name="Part_ClosePopupButton" Content="X" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Right"/>
                                        <Grid x:Name="Part_BalloonPopupGrid"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Canvas x:Name="TooltipPanel"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="DefaultAnnotationTemplate">
        <Grid>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <ContentPresenter  Content="{Binding Path=AnnotationSymbol}" />
                <Grid Background="{Binding Path=AnnotationLabelBackground}">
                    <TextBlock x:Name="PART_SymbolTextBlock"
                               VerticalAlignment="Center"
                               Text="{Binding Path=AnnoktationLabel}"
                               FontFamily="{Binding Path=AnnotationLabelFontFamily}"
                               FontSize="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=CaptionText}}"
                               Foreground="{StaticResource ContentForeground}"
                               FontStyle="{Binding  Path=AnnotationLabelFontStyle}" />
                </Grid>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DefaultLabelTemplate">
        <Border Background="Transparent">
            <TextBlock FontStyle="{Binding Setting.MapItemFontStyle}"
                       FontSize="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=CaptionText}}"
                       FontWeight="{StaticResource Windows11TealLightTheme.FontWeightNormal}"
                       Text="{Binding MapItemValue}"
                       Foreground="{StaticResource ContentForeground}" />
        </Border>
    </DataTemplate>

    <Style x:Key="SyncfusionSfMapShapeFileLayerStyle" TargetType="syncfusion:ShapeFileLayer">
        <Setter Property="ShapeFill" Value="{StaticResource Series11}" />
        <Setter Property="ShapeStroke" Value="{StaticResource Series8}" />
        <Setter Property="CrossCursorStroke" Value="{StaticResource Series10}" />
        <Setter Property="MarkerIconFill" Value="{StaticResource Series2}" />
        <Setter Property="MarkerLabelFontFamily" Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=ThemeFontFamily}}" />
        <Setter Property="MarkerLabelFontSize" Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=HeaderTextStyle}}" />
        <Setter Property="MarkerLabelFontWeight" Value="{StaticResource Windows11TealLightTheme.FontWeightNormal}" />
        <Setter Property="MarkerLabelForeground" Value="{StaticResource ContentForeground}" />
        <Setter Property="ItemsTemplate" Value="{StaticResource DefaultLabelTemplate}" />
        <Setter Property="AnnotationTemplate" Value="{StaticResource DefaultAnnotationTemplate}" />
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="MapPointPopupTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <TextBlock Text="{Binding TooltipText}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid x:Name="PART_ShapeFileGrid" Background="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Background}">
                        <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=VisibleShapes,Mode=TwoWay}" x:Name="Control1" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <syncfusion:ShapeFilePanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=MapPoints,Mode=TwoWay}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=SubShapeFileLayers}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Bubbles}" Opacity="{Binding RelativeSource={RelativeSource TemplatedParent},Path=BubbleMarkerSetting.Opacity}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Margin="{Binding Margin}" Content="{Binding BubbleItem}" IsTabStop="False"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Grid Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LegendMargin}" 
                              Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},Path=LegendVisibility}"
                              HorizontalAlignment="{Binding LegendHorizontalAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                              VerticalAlignment="{Binding LegendVerticalAlignment, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Margin="10,0">
                                <!--The control template is currently handled with hardcoded values based on the source style to support dynamic theme switching. The code was copied from the Maps source to replicate the existing UI. We now need to improve the UI by applying theme-based styles and updating mapping keys in excel sheets.-->
                                <TextBlock Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LegendWidth}" HorizontalAlignment="Left" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LegendHeader}" FontSize="14" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                            </Border>
                            <ItemsControl x:Name="LegendControl" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DefaultLegendVisibility}" Grid.Row="1" ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Legends}" HorizontalAlignment="Left" VerticalAlignment="Top" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ContentControl Content="{Binding LegendIcon}" Margin="10" IsTabStop="False" />
                                            <TextBlock HorizontalAlignment="Left" Text="{Binding LegendLabel}" Margin="{Binding LegendLabelMargin}" Foreground="{Binding LabelForeground}" FontSize="{Binding LabelFontSize}" FontStyle="{Binding LegendFontStyle}" FontFamily="{Binding LegendFontFamily}" VerticalAlignment="Center" Focusable="False"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <syncfusion:LegendPanel>
                                            <syncfusion:LegendPanel.Background>
                                                <!--The control template is currently handled with hardcoded values based on the source style to support dynamic theme switching. The code was copied from the Maps source to replicate the existing UI. We now need to improve the UI by applying theme-based styles and updating mapping keys in excel sheets.-->
                                                <SolidColorBrush Opacity="0.5" Color="WhiteSmoke"/>
                                            </syncfusion:LegendPanel.Background>
                                        </syncfusion:LegendPanel>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Grid Grid.Row="2" Margin="0,10,0,0" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=InteractiveLegendVisibility}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StartLabel" Margin="5,0,5,0" Grid.Row="0" Grid.Column="0" Text="{Binding RelativeSource={RelativeSource TemplatedParent},Path=LegendStartLabel}"/>
                                <ItemsControl x:Name="InteractiveLegendControl" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Legends}" HorizontalAlignment="Left" VerticalAlignment="Top" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ContentControl Content="{Binding LegendIcon}" IsTabStop="False"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <syncfusion:InteractiveLegendPanel>
                                                <syncfusion:InteractiveLegendPanel.Background>
                                                    <!--The control template is currently handled with hardcoded values based on the source style to support dynamic theme switching. The code was copied from the Maps source to replicate the existing UI. We now need to improve the UI by applying theme-based styles and updating mapping keys in excel sheets.-->
                                                    <SolidColorBrush Opacity="0.5" Color="WhiteSmoke"/>
                                                </syncfusion:InteractiveLegendPanel.Background>
                                            </syncfusion:InteractiveLegendPanel>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="EndLabel" Grid.Row="0" Margin="5,0,5,0" Grid.Column="2" Text="{Binding RelativeSource={RelativeSource TemplatedParent},Path=LegendEndLabel}"/>
                                <!--The control template is currently handled with hardcoded values based on the source style to support dynamic theme switching. The code was copied from the Maps source to replicate the existing UI. We now need to improve the UI by applying theme-based styles and updating mapping keys in excel sheets.-->
                                <Polygon x:Name="InteractiveArrow" Margin="0,15,0,0" Points="0,0 8,5 0,10" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" Width="10" Height="10" Fill="Black">
                                    <Polygon.RenderTransform>
                                        <RotateTransform Angle="270"/>
                                    </Polygon.RenderTransform>
                                </Polygon>
                            </Grid>
                        </Grid>
                        <ItemsControl x:Name="PART_MapItemsControl" IsTabStop="False" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},Path=MapItemsVisibility}" ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=MapItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" ContentTemplate="{Binding Template}" IsTabStop="False"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <syncfusion:MapItemsPanel x:Name="mapItemsPanel"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Annotations}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Margin="{Binding AnnotationMargin}" Content="{Binding}" IsTabStop="False" ContentTemplate="{Binding AnnotationTemplate}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="SmartLabelMeasureTextView" Margin="2" HorizontalAlignment="Center" Foreground="Transparent" IsHitTestVisible="False" />
                        <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=CustomDataSymbols}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Margin="{Binding Margin}" IsTabStop="False" Content="{Binding}" ContentTemplate="{Binding CustomDataSymbolTemplate}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Canvas Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MapPopupVisibility}">
                            <ContentControl Content="{Binding}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},Path=PopupVisibility}" x:Name="PART_MapPopupContent" Margin="{Binding RelativeSource={RelativeSource TemplatedParent},Path=MapPopupMargin}" ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent},Path=MapPopupTemplate}" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent},Path=MapPopupObject}"/>
                        </Canvas>
                        <Canvas>
                            <ContentControl Content="{Binding}" IsTabStop="False" x:Name="tooltip" Margin="{Binding Path=MapPointMargin,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource marginConverter}}" VerticalAlignment="Top" Visibility="{Binding Path=MapPointPopupVisibility,RelativeSource={RelativeSource TemplatedParent}}" ContentTemplate="{Binding Path=MapPointPopupTemplate,RelativeSource={RelativeSource TemplatedParent}}" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent},Path=PointData}"/>
                        </Canvas>
                        <Canvas>
                            <Rectangle Height="{Binding RelativeSource={RelativeSource TemplatedParent},Path=SelectionRect.Height}" Width="{Binding RelativeSource={RelativeSource TemplatedParent},Path=SelectionRect.Width}" StrokeDashArray="5,2" Stroke="{Binding RelativeSource={RelativeSource TemplatedParent},Path=SelectionRectStroke}" StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent},Path=SelectionRectStrokeThickness}" Canvas.Left="{Binding RelativeSource={RelativeSource TemplatedParent},Path=SelectionRect.Left}" Canvas.Top="{Binding RelativeSource={RelativeSource TemplatedParent},Path=SelectionRect.Top}"/>
                        </Canvas>
                        <Canvas Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},Path=CrossCursorVisibility}">
                            <Line IsHitTestVisible="False" Canvas.Left="{Binding RelativeSource={RelativeSource TemplatedParent},Path=CursorPosition.X}" X1="0" X2="0" Y1="0" Y2="{Binding RelativeSource={RelativeSource TemplatedParent},Path=LayerHeight}" Stroke="{Binding RelativeSource={RelativeSource TemplatedParent},Path=CrossCursorStroke}" StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent},Path=CrossCursorStrokeThickness}"/>
                            <Line IsHitTestVisible="False" Canvas.Top="{Binding RelativeSource={RelativeSource TemplatedParent},Path=CursorPosition.Y}" X1="0" X2="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LayerWidth}" Y1="0" Y2="0" Stroke="{Binding RelativeSource={RelativeSource TemplatedParent},Path=CrossCursorStroke}" StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent},Path=CrossCursorStrokeThickness}"/>
                        </Canvas>
                        <Grid x:Name="PART_DistanceScaleGrid" Margin="0 0 20 20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ShowDistanceScale, Converter={StaticResource visibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.3*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!--The control template is currently handled with hardcoded values based on the source style to support dynamic theme switching. The code was copied from the Maps source to replicate the existing UI. We now need to improve the UI by applying theme-based styles and updating mapping keys in excel sheets.-->
                            <TextBlock Text="{Binding Distance, RelativeSource={RelativeSource TemplatedParent}}" FontSize="10" FontFamily="Segoe UI"/>
                            <Border Margin="15 0 0 0" x:Name="PART_DistanceScale" Grid.Column="1" BorderBrush="#FF808080" Width="100" Height="15" BorderThickness="2 0 2 2"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SyncfusionSfMapImageryLayerStyle" TargetType="syncfusion:ImageryLayer">
        <Setter Property="MarkerIconFill" Value="{StaticResource Series2}" />
        <Setter Property="MarkerLabelFontFamily" Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=ThemeFontFamily}}" />
        <Setter Property="MarkerLabelFontSize" Value="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=HeaderTextStyle}}" />
        <Setter Property="MarkerLabelFontWeight" Value="{StaticResource Windows11TealLightTheme.FontWeightNormal}" />
        <Setter Property="MarkerLabelForeground" Value="{StaticResource ContentForeground}" />
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type syncfusion:ImageryLayer}">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid x:Name="PART_TileGrid" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                            <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=SubShapeFileLayers}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=CustomDataSymbols}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Margin="{Binding Margin}" Content="{Binding}" ContentTemplate="{Binding CustomDataSymbolTemplate}" IsTabStop="False"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="syncfusion:ImageryLayer"           BasedOn="{StaticResource SyncfusionSfMapImageryLayerStyle}" />
    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Control=Syncfusion.UI.Xaml.Maps.ImageryLayer}" TargetType="syncfusion:ImageryLayer"           BasedOn="{StaticResource SyncfusionSfMapImageryLayerStyle}" />
    
    <Style TargetType="syncfusion:SfMap"           BasedOn="{StaticResource SyncfusionSfMapStyle}" />
    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Control=Syncfusion.UI.Xaml.Maps.SfMap}" TargetType="syncfusion:SfMap"           BasedOn="{StaticResource SyncfusionSfMapStyle}" />

    <Style TargetType="syncfusion:ShapeFileLayer"           BasedOn="{StaticResource SyncfusionSfMapShapeFileLayerStyle}" />
    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Control=Syncfusion.UI.Xaml.Maps.ShapeFileLayer}" TargetType="syncfusion:ShapeFileLayer"           BasedOn="{StaticResource SyncfusionSfMapShapeFileLayerStyle}" />

    <DataTemplate x:Key="DiamondBubbleType">
        <Path Data="F1M1433.97,-17.992L1401.97,-49.992 1433.97,-81.992 1465.97,-49.992 1433.97,-17.992z"
              Stretch="Fill"
              Stroke="{StaticResource White}"
              StrokeThickness="{Binding StrokeThickness}" />
    </DataTemplate>

    <DataTemplate x:Key="TriangleBubbleType">
        <Path Data="F1M1719.66,218.12L1735.66,246.166 1751.66,274.21 1719.66,274.21 1687.66,274.21 1703.66,246.166 1719.66,218.12z"
              Stretch="Fill"
              Stroke="{StaticResource White}"
              StrokeThickness="{Binding StrokeThickness}" />
    </DataTemplate>

    <DataTemplate x:Key="TrapezoidBubbleType">
        <Path Data="F1 M 257.147,126.953L 543.657,126.953L 640.333,448.287L 160.333,448.287L 257.147,126.953 Z"
              Stretch="Fill"
              Stroke="{StaticResource White}"
              StrokeThickness="{Binding StrokeThickness}" />
    </DataTemplate>

    <DataTemplate x:Key="StarBubbleType">
        <Path Data="M1540.22,2082.07L1546.95,2102.78 1568.73,2102.78 1551.11,2115.58 1557.84,2136.29 1540.22,2123.49 1522.6,2136.29 1529.33,2115.58 1511.71,2102.78 1533.49,2102.78 1540.22,2082.07z"
              Stretch="Fill"
              Stroke="{StaticResource White}"
              StrokeThickness="{Binding StrokeThickness}" />
    </DataTemplate>

    <DataTemplate x:Key="PinBubbleType">
        <Path Data="F1M1525.83,266.24L1529.12,256.359 1539,246.478 1542.29,249.771 1552.17,246.478 1542.29,236.598 1545.59,233.304 1559.25,212.907 1539,226.718 1535.71,230.008 1540.88,235.189 1525.83,220.131 1522.53,230.008 1525.83,233.304 1515.95,243.181 1506.06,246.478 1525.83,266.24z"
              Stretch="Fill"
              RenderTransformOrigin="0.5,0.5"
              Stroke="{StaticResource White}"
              StrokeThickness="{Binding StrokeThickness}">
            <Path.RenderTransform>
                <RotateTransform Angle="180" />
            </Path.RenderTransform>
        </Path>
    </DataTemplate>

    <DataTemplate x:Key="PentagonBubbleType">
        <Path Data="F1M1703.66,-21.7902L1687.66,-49.7902 1719.66,-77.7902 1751.66,-49.7902 1735.66,-21.7902 1703.66,-21.7902z"
              Stretch="Fill"
              Stroke="{StaticResource White}"
              StrokeThickness="{Binding StrokeThickness}" />
    </DataTemplate>

    <DataTemplate x:Key="RectangleBubbleType">
        <Rectangle Stretch="Fill"
                   Stroke="{StaticResource White}"
                   StrokeThickness="{Binding StrokeThickness}" />
    </DataTemplate>

    <DataTemplate x:Key="EllipseBubbleType">
        <Ellipse Stretch="Fill"
                 Stroke="{StaticResource White}"
                 StrokeThickness="{Binding StrokeThickness}" />
    </DataTemplate>

</ResourceDictionary>
