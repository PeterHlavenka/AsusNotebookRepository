<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:themelocal="clr-namespace:Syncfusion.Themes.Windows11TealLightTheme.WPF"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sfskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
                    xmlns:surfaceChart="clr-namespace:Syncfusion.UI.Xaml.Charts;assembly=Syncfusion.SfChart.WPF" 
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <sfskin:ResourceDictionaryProvider DictionaryName="Common" ThemeName="Windows11TealLightTheme"/>
        <sfskin:ResourceDictionaryProvider DictionaryName="Brushes" ThemeName="Windows11TealLightTheme"/>
    </ResourceDictionary.MergedDictionaries>

    <!--AxisLabel-->

    <!--AxisGridLines-->

    <!--AxisLine-->

    <!--AxisLabel-->

    <!--AxisHeader-->

    <Style x:Key="SyncfusionLineStyle" TargetType="Line">
        <Setter Property="Stroke" Value="{StaticResource BorderAlt4}"/>
        <Setter Property="StrokeThickness" Value="2"/>
    </Style>

    <DataTemplate x:Key="SyncfusionSurfaceAxisLabelTemplate">
        <Grid Background="Transparent">
            <TextBlock Text="{Binding LabelContent}"
                       Foreground="{StaticResource ContentForeground}"
                       FontSize="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=CaptionText}}" 
                       FontWeight="{StaticResource Windows11TealLightTheme.FontWeightNormal}"
                       FontFamily="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=ThemeFontFamily}}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SyncfusionSurfaceAxisHeaderTemplate">
        <Grid Background="Transparent">
            <TextBlock Text="{Binding}"
                Foreground="{StaticResource ContentForeground}"
                FontSize="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=CaptionText}}" 
                FontWeight="{StaticResource Windows11TealLightTheme.FontWeightNormal}"
                FontFamily="{DynamicResource {sfskin:ThemeKey Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Key=ThemeFontFamily}}"/>
        </Grid>
    </DataTemplate>

    <Style x:Key="SyncfusionSurfaceAxisStyle" TargetType="surfaceChart:SurfaceAxis">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MajorTickLineStyle" Value="{StaticResource SyncfusionLineStyle}"/>
        <Setter Property="MinorTickLineStyle" Value="{StaticResource SyncfusionLineStyle}"/>
        <Setter Property="AxisLineStyle" Value="{StaticResource SyncfusionLineStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource BorderAlt1}"/>
        <Setter Property="HeaderTemplate" Value="{StaticResource SyncfusionSurfaceAxisHeaderTemplate}" />
        <Setter Property="LabelTemplate" Value="{StaticResource SyncfusionSurfaceAxisLabelTemplate}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="surfaceChart:SurfaceAxis">
              <Border Background="{TemplateBinding Background}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">
                  <surfaceChart:SurfaceAxisPanel x:Name="axisPanel"
                                                 Background="Transparent">
                      <ContentControl x:Name="headerContent"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Content="{TemplateBinding Header}"
                                      RenderTransformOrigin="0.5,0.5"/>
                      <Canvas x:Name="axisLabelsPanel" />
                      <Canvas x:Name="axisElementPanel" />
                  </surfaceChart:SurfaceAxisPanel>
              </Border>
           </ControlTemplate>
          </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource SyncfusionSurfaceAxisStyle}" TargetType="surfaceChart:SurfaceAxis"/>
    <Style x:Key="{sfskin:DefaultStyleKeyExtension Theme={x:Type themelocal:Windows11TealLightThemeSkinHelper}, Control=Syncfusion.UI.Xaml.Charts.SurfaceAxis}" BasedOn="{StaticResource SyncfusionSurfaceAxisStyle}" TargetType="surfaceChart:SurfaceAxis"/>

</ResourceDictionary>
